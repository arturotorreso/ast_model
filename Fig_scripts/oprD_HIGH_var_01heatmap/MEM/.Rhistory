summaryDF<-as.matrix(metab_abund.plsda@summaryDF)
write.table(performance, 'D://R/projects/ZR/精补料/PLSDA-OPLSDA/rumen/summaryDF.txt',
row.names = FALSE, sep = '\t', quote = FALSE)
